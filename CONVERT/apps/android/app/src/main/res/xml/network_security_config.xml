<?xml version="1.0" encoding="utf-8"?>
<!--
    Cấu hình An toàn Mạng (Network Security Config) cho NextAI Downloader
    Đảm bảo các kết nối nội bộ bắt buộc HTTPS và kiểm soát rõ ràng lưu lượng HTTP
    @package com.nextaitechnology.antidetect
-->
<network-security-config>
    <!-- Mặc định chỉ cho phép lưu lượng HTTPS TLS 1.2/1.3 an toàn -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Miền nội bộ NextAI bắt buộc mã hóa và bảo mật tối đa -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">nextaitechnology.com</domain>
        <domain includeSubdomains="true">deepthought.industries</domain>
        <!-- Dự phòng cấu hình Certificate Pinning (SHA-256) -->
        <pin-set expiration="2027-12-31">
            <!-- Pin mẫu dự phòng cho server NextAI -->
            <pin digest="SHA-256">47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU=</pin>
        </pin-set>
    </domain-config>

    <!-- Cho phép duyệt HTTP thông thường trong WebView đối với các website công cộng của người dùng -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Áp dụng cho các trang web cũ không có SSL khi người dùng duyệt bằng trình duyệt nội bộ -->
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
