<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Quyền truy cập mạng và kiểm tra trạng thái kết nối -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Quyền tiến trình chạy ngầm & thông báo tải video -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Gỡ bỏ triệt để quyền FOREGROUND_SERVICE bị thư viện con (AdMob/work-runtime) tự động merge vào -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"
        tools:node="remove" />

    <!-- Quyền lưu trữ & SAF (Storage Access Framework) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <!-- Quyền điều khiển phát video màn hình sáng -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Khai báo Package Visibility cho Android 11+ (API 30+) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".NextAIApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/backup_rules"
        android:fullBackupContent="@xml/full_backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NextAIDownloader"
        android:networkSecurityConfig="@xml/network_security_config"
        android:hardwareAccelerated="true">

        <!-- Màn hình chính điều phối (Browser, Progress, Player Hub) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Intent filter bắt link chia sẻ từ mạng xã hội -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Trình phát video chuyên nghiệp AcePlayer -->
        <activity
            android:name=".feature.player.AcePlayerActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="portrait"
            android:supportsPictureInPicture="true" />

        <!-- Màn hình Cài đặt hệ thống -->
        <activity
            android:name=".feature.settings.SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/title_settings" />

        <!-- Màn hình Chọn ngôn ngữ đa quốc gia -->
        <activity
            android:name=".feature.settings.LanguageActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/title_language" />

        <!-- FileProvider an toàn để mở và chia sẻ file video đã tải -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Màn hình Đăng ký / Payment Wall (Paywall) -->
        <activity
            android:name=".feature.settings.PaymentWallActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.NextAIDownloader" />

        <!-- Google Mobile Ads (AdMob) App ID (Google Test ID) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <!-- Gỡ xung đột AD_SERVICES_CONFIG giữa Google Mobile Ads & Firebase Analytics -->
        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            android:resource="@xml/gma_ad_services_config"
            tools:replace="android:resource" />

        <!-- Gỡ bỏ triệt để SystemForegroundService của work-runtime để Google Play Console không phát hiện FGS -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />

    </application>

</manifest>
